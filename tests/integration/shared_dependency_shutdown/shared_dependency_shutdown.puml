@startuml shared_dependency_shutdown

title Integration test: shared_dependency_shutdown\nA shared dependency must outlive the graceful shutdown of every dependent

participant "control_client_test_driver" as Driver
participant "Launch Manager" as LM

participant "component_shared\n(component_shared_process)" as Shared

box "dependent_process instances" #F0F4FA
participant "component_fast\n--stop-delay-ms 300" as Fast
participant "component_slow\n--stop-delay-ms 1500" as Slow
end box

database "POSIX shm counters\nstart / stop / violation" as Shm

note over Driver, Slow
  component_fast, component_slow --> component_shared (diamond)
  stop counter increments on exit, not on SIGTERM
end note

' --- startup -----------------------------------------------------------------
activate LM
LM -> Driver ++: start (Run Target "Startup")
Driver -> LM: report_running()
LM --> Driver: callback: "Startup" activated

Driver -> LM: activate_run_target("run_target_diamond")

LM -> Shared ++: start
Shared -> Shm: ++start counter
Shared -> LM: report_running()

note over LM: start only once component_shared is active

par
  LM -> Fast ++: start
  Fast -> Shm: ++start counter
  Fast -> LM: report_running()
else
  LM -> Slow ++: start
  Slow -> Shm: ++start counter
  Slow -> LM: report_running()
end

LM --> Driver: callback: "run_target_diamond" activated
Driver -> Shm: read start counter
Shm --> Driver: 3
Driver -> Shm: read stop counter
Shm --> Driver: 0

' --- shutdown ----------------------------------------------------------------
Driver -> LM: activate_run_target("Startup")

note over LM: not needed by "Startup"; both ready to stop at once

par
  LM -> Fast: SIGTERM
  Fast -> Fast: graceful shutdown work (300 ms)
else
  LM -> Slow: SIGTERM
  Slow -> Slow: graceful shutdown work (1500 ms)
end

Fast -> Shm: ++stop counter (now 1)
Fast --> LM: onNodeFinished(component_fast)
destroy Fast

note over LM #F2FAF2
  stopped_ is set only by onNodeFinished(), not active() -- component_slow's
  bit is still false, so component_shared stays blocked.
  Pre-fix: active() was re-read here and already false -> signalled ~1.2s early.
  See Transition::onNodeFinished(); transition_UT.cpp SharedDependencyOfTwoRootsTest.
end note

Slow -> Shm: ++stop counter (now 2)
Slow --> LM: onNodeFinished(component_slow)
destroy Slow

note over LM: both dependents now stopped

LM -> Shared: SIGTERM
Shared -> Shm: read stop counter
Shm --> Shared: 2
note right of Shared: no violation
Shared -> Shm: ++stop counter (now 3)
Shared --> LM: onNodeFinished(component_shared)
destroy Shared

' --- verdict -----------------------------------------------------------------
LM --> Driver: callback: "Startup" activated

Driver -> Shm: read violation counter
Shm --> Driver: 0
note right of Driver: EXPECT_EQ(violation_counter.get(), 0) <b>passes</b>

Driver -> Shm: read stop counter
Shm --> Driver: 3
deactivate Driver
deactivate LM

legend bottom
  Fast/slow stop in parallel (300ms vs 1500ms), both under the 5000ms shutdown_timeout_ms.
end legend

@enduml
