{
    "schema_version": 2,
    "defaults": {
        "deployment_config": {
            "bin_dir": "/tmp/tests/shared_dependency_shutdown",
            "ready_timeout_ms": 5000,
            "shutdown_timeout_ms": 5000,
            "environmental_variables": {
                "LD_LIBRARY_PATH": "/opt/lib"
            },
            "sandbox": {
                "uid": 0,
                "gid": 0,
                "scheduling_policy": "SCHED_OTHER",
                "scheduling_priority": 0
            }
        },
        "component_properties": {
            "application_profile": {
                "application_type": "Reporting",
                "is_self_terminating": false
            },
            "ready_condition": {
                "process_state": "Running"
            }
        }
    },
    "components": {
        "control_client_test_driver": {
            "component_properties": {
                "binary_name": "control_client_test_driver",
                "application_profile": {
                    "application_type": "State_Manager",
                    "alive_supervision": {
                        "min_indications": 0
                    }
                }
            },
            "deployment_config": {
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "control_client_test_driver"
                }
            }
        },
        "component_shared": {
            "component_properties": {
                "binary_name": "component_shared_process"
            }
        },
        "component_fast": {
            "component_properties": {
                "binary_name": "dependent_process",
                "depends_on": [
                    "component_shared"
                ],
                "process_arguments": [
                    "--stop-delay-ms",
                    "300"
                ]
            },
            "deployment_config": {
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "fast"
                }
            }
        },
        "component_slow": {
            "component_properties": {
                "binary_name": "dependent_process",
                "depends_on": [
                    "component_shared"
                ],
                "process_arguments": [
                    "--stop-delay-ms",
                    "1500"
                ]
            },
            "deployment_config": {
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "slow"
                }
            }
        }
    },
    "run_targets": {
        "Startup": {
            "depends_on": [
                "control_client_test_driver"
            ]
        },
        "Off": {
            "depends_on": []
        },
        "run_target_diamond": {
            "depends_on": [
                "control_client_test_driver",
                "component_fast",
                "component_slow"
            ]
        }
    },
    "initial_run_target": "Startup",
    "fallback_run_target": {
        "depends_on": [
            "control_client_test_driver"
        ]
    }
}
