{
    "schema_version": 2,
    "defaults": {
        "deployment_config": {
            "bin_dir": "/tmp/tests/cpp_alive",
            "ready_timeout_ms": 1000,
            "shutdown_timeout_ms": 1000,
            "recovery_action": {
                "switch_run_target": {
                    "run_target": "fallback_run_target"
                }
            },
            "environmental_variables": {
                "LD_LIBRARY_PATH": "/opt/lib"
            },
            "sandbox": {
                "uid": 0,
                "gid": 0,
                "scheduling_policy": "SCHED_OTHER",
                "scheduling_priority": 0
            }
        },
        "component_properties": {
            "application_profile": {
                "application_type": "Reporting_And_Supervised",
                "is_self_terminating": false,
                "alive_supervision": {
                    "reporting_cycle_ms": 200,
                    "failed_cycles_tolerance": 0,
                    "min_indications": 2,
                    "max_indications": 8
                }
            },
            "ready_condition": {
                "process_state": "Running"
            }
        }
    },
    "components": {
        "control_client_test_driver": {
            "component_properties": {
                "binary_name": "control_client_test_driver",
                "application_profile": {
                    "application_type": "State_Manager",
                    "alive_supervision": {
                        "min_indications": 0
                    }
                }
            },
            "deployment_config": {
                "environmental_variables": {
                    "PROCESSIDENTIFIER": "control_client_test_driver"
                }
            }
        },
        "too_few_component": {
            "component_properties": {
                "binary_name": "cpp_alive_process",
                "process_arguments": [
                    "--reports=5"
                ]
            }
        },
        "too_many_component": {
            "component_properties": {
                "binary_name": "cpp_alive_process",
                "process_arguments": [
                    "--period_ms=5"
                ]
            }
        },
        "success_component": {
            "component_properties": {
                "binary_name": "cpp_alive_process"
            }
        },
        "verification_component": {
            "component_properties": {
                "binary_name": "verification_process",
                "process_arguments": [
                    "fallback_run_target"
                ],
                "depends_on": [],
                "application_profile": {
                    "application_type": "Native",
                    "is_self_terminating": true
                },
                "ready_condition": {
                    "process_state": "Terminated"
                }
            }
        }
    },
    "run_targets": {
        "Startup": {
            "depends_on": [
                "control_client_test_driver"
            ]
        },
        "too_few": {
            "depends_on": [
                "control_client_test_driver",
                "too_few_component"
            ]
        },
        "too_many": {
            "depends_on": [
                "control_client_test_driver",
                "too_many_component"
            ]
        },
        "success": {
            "depends_on": [
                "control_client_test_driver",
                "success_component"
            ]
        },
        "Off": {
            "depends_on": []
        }
    },
    "initial_run_target": "Startup",
    "alive_supervision": {
        "evaluation_cycle_ms": 50
    },
    "fallback_run_target": {
        "depends_on": [
            "control_client_test_driver",
            "verification_component"
        ]
    }
}
