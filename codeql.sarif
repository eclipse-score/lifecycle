              "shortDescription": {
                "text": "RULE-6-4-1: A variable declared in an inner scope shall not hide a variable declared in an outer scope"
              },
              "fullDescription": {
                "text": "Use of an identifier declared in an inner scope with an identical name to an identifier in an outer scope can lead to inadvertent errors if the incorrect identifier is modified."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
