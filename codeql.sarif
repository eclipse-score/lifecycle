                "id": "cpp/misra/no-memory-functions-from-c-string",
                "kind": "problem",
                "name": "RULE-24-5-2: The C++ Standard Library functions memcpy, memmove and memcmp from <cstring> shall not be used",
                "precision": "very-high",
                "problem.severity": "error"
              }
            },
