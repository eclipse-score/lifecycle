                "problem.severity": "error"
              }
            },
            {
              "id": "cpp/misra/no-standalone-type-cast-expression",
              "name": "cpp/misra/no-standalone-type-cast-expression",
              "shortDescription": {
                "text": "RULE-9-2-1: An explicit type conversion shall not be an expression statement"
              },
