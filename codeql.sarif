              "id": "cpp/misra/non-const-predicate-function-object",
              "name": "cpp/misra/non-const-predicate-function-object",
              "shortDescription": {
                "text": "RULE-28-3-1: Predicates shall not have persistent side effects"
              },
              "fullDescription": {
                "text": "Much of the behavior of predicates is implementation defined, such as how and when it is invoked with which argument values, and if it is copied or moved. Therefore, predicate function objects should be declared const."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
                "tags": [
                  "external/misra/id/rule-28-3-1",
                  "scope/system",
                  "correctness",
                  "maintainability",
