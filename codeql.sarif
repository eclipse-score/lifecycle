              "id": "cpp/cert/throwing-operator-new-returns-null-cert",
              "name": "cpp/cert/throwing-operator-new-returns-null-cert",
              "shortDescription": {
                "text": "MEM55-CPP: Replacement operator new returns null instead of throwing std:bad_alloc"
              },
              "fullDescription": {
                "text": "Replacement implementations of throwing operator new should not return null as it violates the 'Required behavior' clause from the C++ Standard."
