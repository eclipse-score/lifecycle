                ],
                "description": "Much of the behavior of predicates is implementation defined, such as how and when\n              it is invoked with which argument values, and if it is copied or moved. Therefore,\n              predicate function objects should be declared const.",
                "id": "cpp/misra/non-const-predicate-function-object",
                "kind": "problem",
                "name": "RULE-28-3-1: Predicates shall not have persistent side effects",
                "precision": "very-high",
                "problem.severity": "error"
              }
            },
