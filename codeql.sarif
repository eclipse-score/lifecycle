              "name": "cpp/misra/avoid-program-terminating-functions",
              "shortDescription": {
                "text": "RULE-18-5-2: Program-terminating functions should not be used"
              },
              "fullDescription": {
                "text": "Using program-terminating functions like abort, exit, _Exit, quick_exit or terminate causes the stack to not be unwound and object destructors to not be called, potentially leaving the environment in an undesirable state."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "error"
              },
              "properties": {
