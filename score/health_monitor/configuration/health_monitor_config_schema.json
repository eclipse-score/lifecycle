{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Health Monitor Configuration",
    "description": "Configuration of one health monitor instance.\nAt least one monitor is required.",
    "type": "object",
    "required": [
        "schema_version"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "description": "Version of this configuration schema.",
            "minimum": 1,
            "maximum": 1
        },
        "supervisor_api_cycle_ms": {
            "type": "integer",
            "title": "Supervisor API Cycle",
            "description": "Time in milliseconds between two alive notifications to the supervisor.\nIt must be an integer multiple of internal_processing_cycle_ms.",
            "default": 500,
            "minimum": 1
        },
        "internal_processing_cycle_ms": {
            "type": "integer",
            "title": "Internal Processing Cycle",
            "description": "Time in milliseconds between two checks of all monitors.",
            "default": 100,
            "minimum": 1
        },
        "thread_parameters": {
            "type": "object",
            "title": "Thread Parameters",
            "description": "Scheduling, CPU affinity and stack size of the monitoring thread.",
            "additionalProperties": false,
            "properties": {
                "scheduler_parameters": {
                    "type": "object",
                    "title": "Scheduler Parameters",
                    "description": "Scheduling policy and priority.\nIf not set, the monitoring thread inherits the scheduling of the thread that starts the health monitor.",
                    "required": [
                        "policy",
                        "priority"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "policy": {
                            "type": "string",
                            "title": "Policy",
                            "description": "Scheduling policy.",
                            "enum": [
                                "OTHER",
                                "FIFO",
                                "RR"
                            ]
                        },
                        "priority": {
                            "type": "integer",
                            "title": "Priority",
                            "description": "Priority within the range the operating system accepts for the policy."
                        }
                    }
                },
                "affinity": {
                    "type": "array",
                    "title": "Affinity",
                    "description": "CPU indices the monitoring thread can run on, each below the CPU count.\nIf empty or not set, the monitoring thread can run on any CPU.",
                    "items": {
                        "type": "integer"
                    }
                },
                "stack_size": {
                    "type": "integer",
                    "title": "Stack Size",
                    "description": "Stack size in bytes.\nIf not set, the monitoring thread uses the operating system default.\nIt must not be below the minimum of the operating system.",
                    "minimum": 0
                }
            }
        },
        "deadline_monitors": {
            "type": "array",
            "title": "Deadline Monitors",
            "description": "Deadline monitors.",
            "items": {
                "type": "object",
                "title": "Deadline Monitor",
                "description": "A deadline monitor and its deadlines.",
                "required": [
                    "tag",
                    "deadlines"
                ],
                "additionalProperties": false,
                "properties": {
                    "tag": {
                        "type": "string",
                        "title": "Monitor Tag",
                        "description": "Name of the monitor, unique across all monitor kinds."
                    },
                    "deadlines": {
                        "type": "array",
                        "title": "Deadlines",
                        "description": "Deadlines of the monitor.",
                        "items": {
                            "type": "object",
                            "title": "Deadline",
                            "description": "A deadline that must stop within its range after it starts.",
                            "required": [
                                "tag",
                                "range"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "tag": {
                                    "type": "string",
                                    "title": "Deadline Tag",
                                    "description": "Name of the deadline, unique within its deadline monitor."
                                },
                                "range": {
                                    "$ref": "#/$defs/time_range",
                                    "title": "Deadline Range",
                                    "description": "Allowed time between the start and the stop of the deadline."
                                }
                            }
                        }
                    }
                }
            }
        },
        "heartbeat_monitors": {
            "type": "array",
            "title": "Heartbeat Monitors",
            "description": "Heartbeat monitors.",
            "items": {
                "type": "object",
                "title": "Heartbeat Monitor",
                "description": "A heartbeat monitor.",
                "required": [
                    "tag",
                    "range"
                ],
                "additionalProperties": false,
                "properties": {
                    "tag": {
                        "type": "string",
                        "title": "Monitor Tag",
                        "description": "Name of the monitor, unique across all monitor kinds."
                    },
                    "range": {
                        "$ref": "#/$defs/time_range",
                        "title": "Heartbeat Range",
                        "description": "Allowed time between two heartbeats.\nmin_ms must exceed half the internal processing cycle."
                    }
                }
            }
        },
        "logic_monitors": {
            "type": "array",
            "title": "Logic Monitors",
            "description": "Logic monitors.",
            "items": {
                "type": "object",
                "title": "Logic Monitor",
                "description": "A logic monitor and its state graph.",
                "required": [
                    "tag",
                    "initial_state",
                    "states"
                ],
                "additionalProperties": false,
                "properties": {
                    "tag": {
                        "type": "string",
                        "title": "Monitor Tag",
                        "description": "Name of the monitor, unique across all monitor kinds."
                    },
                    "initial_state": {
                        "type": "string",
                        "title": "Initial State",
                        "description": "Tag of the state before the first transition.\nIt must be a state of the monitor."
                    },
                    "states": {
                        "type": "array",
                        "title": "States",
                        "description": "States of the graph.\nAt least one state is required.",
                        "items": {
                            "type": "object",
                            "title": "State",
                            "description": "A state of a logic monitor and the states it can move to.",
                            "required": [
                                "tag",
                                "allowed_states"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "tag": {
                                    "type": "string",
                                    "title": "State Tag",
                                    "description": "Name of the state, unique within its logic monitor."
                                },
                                "allowed_states": {
                                    "type": "array",
                                    "title": "Allowed States",
                                    "description": "Tags of the states this state can move to.\nEach must be a state of the monitor.\nA state can move to itself only if this list contains it.",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "time_range": {
            "type": "object",
            "title": "Time Range",
            "description": "Closed interval [min_ms, max_ms] of whole milliseconds.\nmin_ms must not exceed max_ms.",
            "required": [
                "min_ms",
                "max_ms"
            ],
            "additionalProperties": false,
            "properties": {
                "min_ms": {
                    "type": "integer",
                    "title": "Minimum",
                    "description": "Lower bound in milliseconds.",
                    "minimum": 0
                },
                "max_ms": {
                    "type": "integer",
                    "title": "Maximum",
                    "description": "Upper bound in milliseconds.",
                    "minimum": 0
                }
            }
        }
    }
}
