@startuml component_activation

title Component Activation

box "Main loop thread" #F0F4FA
participant "ProcessGroupManager" as PGM
participant "Graph" as Graph
participant "Transition" as Transition
end box

queue "Worker Queue" as WorkerQueue
queue "Component Event Queue" as EventQueue

box "Worker thread" #FAF6F0
participant "IComponentController" as Monitor
participant "IComponent" as Component
participant "IReadyCondition" as ReadyCondition
participant "IStartAction" as StartAction
participant "IStopAction" as StopAction
participant "IForceStopAction" as ForceStopAction
end box

participant "SafeProcessMap" as Map
participant "Alive Supervision" as Supervision
participant "Operating System" as OS
participant "OsHandler" as OsHandler

note over Graph: graph is in state kInTransition

' --- dispatch ----------------------------------------------------------------
activate Graph
Graph -> Transition ++: get components ready to be started
Transition --> Graph --: component is ready to be started
Graph -> WorkerQueue: activation of the component
note over Graph
  The graph only counts the component as in flight.
  The main loop does not wait for it and returns to
  consuming events.
end note
deactivate Graph

' --- execution ---------------------------------------------------------------
WorkerQueue -> Monitor ++: activation is taken by a free worker
Monitor -> Component ++: activate

loop one iteration per configured startup attempt
    Component -> ReadyCondition: prepare
    Component -> StartAction ++: start
    StartAction -> OS ++: start the process
    OS --> StartAction --:
    StartAction -> Map ++: register the started process PID
    Map --> StartAction --:
    opt #Pink the process PID cannot be entered into the map
        StartAction -> OS: kill the process that was started (SIGKILL)
    end
    StartAction --> Component --: process started, or start failed

    opt the process has already exited when it is registered
        Component -> ReadyCondition: handle termination (exit status)
    end

    Component -> ReadyCondition ++: wait (stop token, process, ready timeout)

    opt the process exits during the wait
        OsHandler -> Component: termination of the process
        Component -> ReadyCondition: handle termination (exit status)
    end
    ReadyCondition --> Component --: ready condition fulfilled, failed or ready timeout expired

    alt #Pink the start action failed
        note right of Component
          The process could not be started, or its PID could not
          be entered into the map. The attempt fails right away;
          nothing is left running, so there is no cleanup.
        end note

    else #F2FAF2 the ready condition is satisfied and the process did not exit unexpectedly
        opt component is supervised
            Component -> Supervision ++: start supervising the process
            Supervision --> Component --: supervision started
        end
        note right of Component
          The component is ready, no further attempt is made.
        end note

    else #Pink the ready condition is satisfied, but supervision cannot be started
        Component -> Supervision ++: start supervising the process
        Supervision --> Component --: failed
        note right of Component
          The attempt fails and goes to the cleanup below, so a
          supervised process never runs without supervision.
        end note

    else #Pink the ready condition is not satisfied
        note right of Component
          The ready timeout expired, the ready condition failed,
          the process exited unexpectedly, or the activation was
          cancelled. The attempt fails and goes to the cleanup below.
        end note
    end

    opt #FFF8E8 cleanup: the attempt failed after the process was started
        Component -> StopAction ++: stop
        StopAction -> OS: request the process to terminate (SIGTERM)
        StopAction --> Component --:
        Component -> Component: wait for the termination of the process,\nup to the shutdown timeout
        opt the shutdown timeout expired
            Component -> ForceStopAction ++: force stop
            ForceStopAction -> OS: kill the process (SIGKILL)
            ForceStopAction --> Component --:
            Component -> Component: wait for the termination of the process,\nup to kMaxSigKillDelay
        end
    end
end

' --- result ------------------------------------------------------------------
alt the ready condition was satisfied
    Component --> Monitor: ready condition satisfied
    Monitor -> EventQueue: component activated successfully
else no attempt succeeded
    Component --> Monitor: activation failed with the result of the last attempt\n(ready timeout or failure)
    Monitor -> EventQueue: component failed to activate
end
deactivate Component
deactivate Monitor

' --- completion --------------------------------------------------------------
EventQueue -> PGM ++: component event
PGM -> Graph ++: apply the component event

alt the event reports a successful activation
    Graph -> Transition ++: component has finished
    Transition --> Graph --: next components ready to be started
    note over Graph
      Once the transition reports that nothing is left,
      the graph moves to kSuccess.
    end note

else the event reports a failed activation
    Graph -> Graph: leave the transition
    note over Graph
      The graph moves to kAborting. The components still in
      flight finish their current step and report back.
      Components that are already running stay running.
    end note
end

deactivate Graph
deactivate PGM

legend bottom
  The two queues are the only interaction between the threads: the graph never
  touches a component directly and a worker never touches the graph. All graph
  and transition state stays confined to the main loop thread.

  Several components may be in flight at the same time; a single one is shown
  here for clarity.
end legend

@enduml
