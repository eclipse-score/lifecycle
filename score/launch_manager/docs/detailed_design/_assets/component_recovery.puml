@startuml component_recovery

title Component Recovery

box "Main loop thread" #F0F4FA
participant "ProcessGroupManager" as PGM
participant "Graph" as Graph
end box

queue "Worker Queue" as WorkerQueue
queue "Component Event Queue" as EventQueue

box "OsHandler thread or worker" #F4F0FA
participant "OsHandler" as OsHandler
participant "ProcessMonitor" as Monitor
participant "Component" as Component
end box

participant "Alive Supervision" as Supervision
participant "Operating System" as OS

' --- Process crash detection ---------------------------------------------------------------
OS -> OsHandler ++: a child process has terminated
OsHandler -> Monitor ++: terminated(component, status)
deactivate OsHandler

Monitor -> Component ++: tryHandleTermination(status)
Component -> Supervision: deactivate supervision

group #Pink Process crash detected
  Component --> Monitor: kFailure
  deactivate Component
  Monitor -> EventQueue: UnexpectedTermination
  deactivate Monitor
end group

' --- reaction ----------------------------------------------------------------
EventQueue -> PGM ++: component event
PGM -> Graph ++: handleComponentEvent()

Graph -> Component ++: deactivate()
Component --> Graph --: clean up done
note over Graph
  The clean up is done in place on the main loop thread, not on a worker.
  Known limitation: if the component crashes right after reaching its
  ready condition, its recovery or activation task may still be finishing
  on a worker while the main loop deactivates it.
end note

' --- recovery ----------------------------------------------------------------
Graph -> Component ++: canRecover()
return true if a restart recovery action is configured

alt Graph State == kAborting || kUndefinedState
  note over Graph
  The component stays deactivated.
  The subsequent transition will restart it if required for the new Run Target.
  end note
else Graph State == kInTransition || !canRecover()
  note over Graph
  The transition or recovery fails: cancel() moves the Graph to kAborting
  (or kUndefinedState if no jobs are running) and stops the ongoing jobs.
  end note
else Graph State == kSuccess || kComponentRecovery
  group #White Executing component recovery action (restart)
    Graph -> Graph: setState(kComponentRecovery)
    Graph -> WorkerQueue: ComponentTask{kRecover}
    deactivate Graph
    deactivate PGM

    WorkerQueue -> Monitor ++: task is taken by a free worker

    alt stop token already stopped (recovery cancelled)
      Monitor -> EventQueue: JobSkipped
    else
      Monitor -> Component ++: recover()
      note over Component
        Restarts the process with the same number of start
        attempts as a regular activation
      end note

      alt Restart successful
        Component -> Supervision: activate supervision
        Component --> Monitor: kSuccess
        Monitor -> EventQueue: ComponentRecoverySuccessful
      else Restart failed, stop token stopped meanwhile
        Component --> Monitor: kFailure / kTimeout
        Monitor -> EventQueue: JobSkipped
        note over Monitor
          A cancelled recovery is never reported as a recovery failure.
        end note
      else #Pink Restart failed
        Component --> Monitor: kFailure / kTimeout
        deactivate Component
        Monitor -> EventQueue: ComponentRecoveryFailed
      end alt
    end alt
    deactivate Monitor
  end group

  ' --- result ---------------------------------------------------------------
  EventQueue -> PGM ++: component event
  PGM -> Graph ++: handleComponentEvent()
  alt ComponentRecoverySuccessful
    note over Graph
      Last job: kComponentRecovery -> kSuccess.
      Otherwise the Graph stays in kComponentRecovery.
      The active Run Target did not change, so no activation is reported.
    end note
  else ComponentRecoveryFailed
    note over Graph
      cancel(): kAborting while other jobs are running, kUndefinedState
      after the last one. The main loop then starts the pending Run Target,
      or the fallback Run Target otherwise.
    end note
  else JobSkipped
    note over Graph
      Only happens in kAborting. kUndefinedState after the last job.
    end note
  end alt
  deactivate Graph
  deactivate PGM
end alt

legend bottom
  A Run Target request for a different Run Target, or a shutdown, while in kComponentRecovery
  cancels the ongoing recoveries: the Graph moves to kAborting and stops their stop token.
  A request for the active Run Target is answered with kAlreadyInState and does not
  interrupt the recovery.
end legend

@enduml
