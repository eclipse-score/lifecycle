@startuml
title Launch Manager - Crash Recovery

autonumber "<b>[00]"

participant "Launch Manager" as LM
participant "OS (kernel)" as kernel

participant "app1" as app1

activate LM
activate app1

...

note over LM,app1
Run Target "Running" successfully active
end note

app1 -> app1: Random crash.
app1 -> kernel: Terminate.
destroy app1
kernel -> LM: Process terminated.

LM -> LM: Determine recovery action

alt App1 has Recovery Action Restart configured

LM -> LM: Start Restart RecoveryAction for app1
LM -> kernel: start app1
kernel -> app1 ++ : start
app1 -> app1 : Initialization

alt Restart Successful
  app1 -> LM : Report Running via Lifecycle API
  LM -> LM: Recovery Action done
else #Pink Restart Failed (Process crash during activation or activation timeout)
  note over LM, app1
  Execute Run Target recovery action
  end note
end alt

deactivate app1

else App1 has Recovery Action Switch Run Target configured

LM -> LM: Determine Transition Plan to new RunTarget

  alt New Run Target successfully activated
    ref over LM, app1
      Activation of the configured Run Target.
      See Run Target Activation sequence diagrams for details.
    end ref
  else #Pink New Run Target activation failed
    note over LM, app1
    Execute Run Target recovery action
    end note
  end alt


else App1 has no Recovery Action configured

note over LM, app1
Execute Run Target recovery action
end note

end alt

...

@enduml
