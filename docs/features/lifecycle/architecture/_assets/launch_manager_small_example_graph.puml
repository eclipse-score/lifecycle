@startuml
  title Simple Dependency Graph

  state Off #lightblue
  state Minimal #lightblue
  state Fallback #LightPink
  state Running #lightblue
  state Full #lightblue

  state app1 #lightgray: Binary: /opt/bin/app1\nReadyCondition: Process reported 'Running'
  state "..." as more #lightgray
  state StateManager #lightgray: Binary: /opt/bin/sm\nReadyCondition: Process reported 'Running'

  state setup_filesystems #lightgray: Binary: /etc/setup_filesystems.sh\nReadyCondition: Process Terminated
  state random #lightgray: Binary: /bin/random\nReadyCondition: /dev/random exists
  
  [*] -r-> Minimal
  Full -d-> more
  Full -d-> Running
  Running --> app1
  Running --> Minimal
  Minimal --> StateManager
  Fallback --> StateManager
  app1 --> setup_filesystems
  app1 --> random
  StateManager --> setup_filesystems

legend right
  |<#lightblue>  | Run Target |
  |<#LightPink>  | Fallback Run Target |
  |<#lightgray>  | Component |
endlegend
@enduml
