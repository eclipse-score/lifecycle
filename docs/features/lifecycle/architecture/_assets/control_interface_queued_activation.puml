@startuml
title Launch Manager - Queued Run Target activation

autonumber "<b>[00]"

participant "StateManager" as sm
participant "Launch Manager" as LM
participant "OS (kernel)" as kernel
participant "setup_filesystems.sh" as fs
participant "random" as ran
participant "app1" as app1

activate LM
activate sm

note over LM
Current Run Target: "Minimal"
Components StateManager and setup_filesystems.sh are Ready.
end note

sm -> LM : Activate Run Target ("Running", forced=False)
LM -> LM: validate Run Target "Running"
alt #White Run Target "Running" is valid
    LM -> LM: Queue Run Target Activation "Running"
    [<-- LM: Request accepted
else #Pink Run Target "Running" is invalid (Example: Run Target not configured)
    [<-- LM: Request rejected
end alt

sm -> LM : Activate Run Target ("Full", forced=False)
LM -> LM: validate Run Target "Full"
alt #White Run Target "Full" is valid
    LM -> LM: Queue Run Target Activation "Full"
    [<-- LM: Request accepted
else #Pink Run Target "Full" is invalid (Example: Run Target not configured)
    [<-- LM: Request rejected
end alt

LM -> LM: Process next queued Run Target Activation: Run Target "Running"
LM -> LM: Determine transition plan from "Minimal" -> "Running"

group #White Start random
LM -> kernel : Start random
kernel -> ran ++ : Start random
LM -> LM : Wait for random ready condition
ran -> kernel : register /dev/random
LM -> LM : Detect /dev/random exists, Component random Ready
end group

group #White Start app1
    LM -> kernel : app1 start
    kernel -> app1 ++ : Start app1
    app1 -> app1 : Initialize
    app1 -> LM : Report Running via Lifecycle API
    LM -> LM : Componetn app1 Ready
end group

LM -> LM: Run Target "Running" successfully activated
[<-- LM: Invoke callback: Run Target "Running" successfully activated due to Request

LM -> LM: Process next queued Run Target Activation: Run Target "Full"
LM -> LM: Determine transition plan from "Running" -> "Full"

...

LM -> LM: Run Target "Full" successfully activated
[<-- LM: Invoke callback: Run Target "Full" successfully activated due to Request


...
@enduml
