@startuml
title Launch Manager - Termination Request

autonumber "<b>[00]"

participant "Launch Manager" as LM
participant "OS (kernel)" as kernel
participant "setup_filesystems.sh" as fs
participant "random" as ran
participant "app1" as app1
participant "StateManager" as sm

activate LM
activate app1
activate ran
activate sm

note over LM,sm
Run Target "Running" is currently active.
Launch Manager has already started Components setup_filesystems.sh, random, app1 and StateManager.
All components are in state `Ready`.
end note

[-> LM : Activate Run Target ("Off", forced=false)
LM -> LM : Determine transition plan

par Stop app1

LM -> app1 : SIGTERM
app1 -> app1 : Terminate

alt App1 terminates within the configured shutdown timeout
    app1 -> kernel : exit
    kernel -> LM : app1 terminated successfully
else #pink App1 does not terminate within the configured timeout
    LM -> app1 : SIGKILL
    app1 -> kernel : exit
    kernel -> LM : app1 terminated with error
end alt

destroy app1

else Stop StateManager

LM -> sm : SIGTERM
sm -> sm : Terminate

alt StateManager terminates within the configured shutdown timeout
    sm -> kernel : exit
    kernel -> LM : StateManager terminated successfully
else #pink StateManager does not terminate within the configured timeout
    LM -> sm : SIGKILL
    sm -> kernel : exit
    kernel -> LM : StateManager terminated with error
end alt

destroy sm

end par

note over LM
    app1 and StateManager are shut down in parallel, now stop their dependencies
    random and setup_filesystems.sh.
    setup_filesystems.sh must only be stopped after both app1 and StateManager,
    since both depend on it.
end note

par Stop random

LM -> ran : SIGTERM

alt Random terminates within the configured shutdown timeout
    ran -> kernel : exit
    kernel -> LM : random terminated successfully
else #pink Random does not terminate within the configured timeout
    LM -> ran : SIGKILL
    ran -> kernel : exit
    kernel -> LM : random terminated with error
end alt

destroy ran

else Stop setup_filesystems.sh

note over LM
    The underlying process for setup_filesystems.sh is already in state terminated. No further action required.
end note

LM -> LM : Mark Component setup_filesystems.sh as Terminated

end par

LM -> LM : Run Target Off successfully activated

...
@enduml
