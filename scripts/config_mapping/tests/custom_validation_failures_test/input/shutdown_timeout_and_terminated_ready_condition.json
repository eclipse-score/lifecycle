{
    "schema_version": 1,
    "defaults": {},
    "components": {
        "shutdown_timeout_and_kterminated": {
            "component_properties": {
                "binary_name": "/bin/true",
                "ready_condition": {
                    "process_state": "Terminated"
                },
                "application_profile": {
                    "application_type": "Native",
                    "is_self_terminating": true
                }
            },
            "deployment_config": {
                "shutdown_timeout_ms": 3000
            }
        }
    },
    "run_targets": {
        "Startup": {
            "depends_on": [
                "shutdown_timeout_and_kterminated"
            ]
        }
    },
    "initial_run_target": "Startup",
    "fallback_run_target": {
        "depends_on": []
    }
}
