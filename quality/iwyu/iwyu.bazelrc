# Check that every C++ file includes what it uses (include-what-you-use).
# Usage: see README.md.
#
# IWYU is based on clang and does not understand GCC-only flags (e.g. -Wformat-diag, -z noexecstack),
# so the analysis uses the LLVM/clang toolchain instead of the GCC toolchain of `--config=x86_64-linux`.
# Do not combine it with `--config=x86_64-linux`. Same toolchain setup as `--config=codeql`.
build:iwyu --config=stub
build:iwyu --platform_suffix=iwyu
build:iwyu --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
build:iwyu --host_platform=@score_bazel_platforms//:x86_64-linux
build:iwyu --incompatible_strict_action_env

build:iwyu --aspects=@bazel_iwyu//:iwyu.bzl%iwyu_aspect
build:iwyu --output_groups=report
# Mappings for external headers without IWYU pragmas, see //quality/iwyu:mappings.
build:iwyu --@bazel_iwyu//:iwyu_mappings=//quality/iwyu:mappings
# Report all findings instead of stopping at the first failing target.
build:iwyu --keep_going
# The query also selects platform-specific targets (e.g. QNX-only osal:start_process); skip them
# instead of failing the build. Same as `--config=codeql`.
build:iwyu --skip_incompatible_explicit_targets
