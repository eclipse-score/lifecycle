# Check that every target depends on what it includes (depend_on_what_you_use).
# Usage: bazel build --config=x86_64-linux --config=dwyu //score/...
build:dwyu --aspects=//quality/dwyu:aspect.bzl%dwyu
build:dwyu --output_groups=dwyu
# Report all findings instead of stopping at the first failing target.
build:dwyu --keep_going
