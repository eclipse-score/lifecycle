{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Refresh compile commands",
            "type": "shell",
            "isBackground": true,
            "command": "bazel-compile-commands --config=x86_64-linux",
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Refresh Clangd",
            "dependsOn": [
                "Refresh compile commands"
            ],
            "command": "${command:clangd.restart}",
            "isBackground": true,
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "Refresh IntelliSense",
            "dependsOn": [
                "Refresh compile commands"
            ],
            "command": "${command:C_Cpp.RescanWorkspace}",
            "isBackground": true,
            "problemMatcher": [],
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
